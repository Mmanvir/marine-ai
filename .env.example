# Run `node scripts/setup-env.js` to create .env with random secrets. Never commit .env.

# --- Backend (Express) ---
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/marinetrace
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=25
UPLOAD_DIR=./uploads
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=CHANGE_ME
DEMO_DATA_DIR=../data/synthetic

# --- Seed script (npm run seed in backend/) ---
SEED_ADMIN_EMAIL=admin@marinetrace.local
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_EMAIL=researcher@marinetrace.local
SEED_DEMO_PASSWORD=CHANGE_ME

# --- ML service (FastAPI) ---
ML_ALLOWED_ORIGINS=http://localhost:4000
